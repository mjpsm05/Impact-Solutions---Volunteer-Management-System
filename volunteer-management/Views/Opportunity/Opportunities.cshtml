@model IEnumerable<Opportunity> 

@{
    ViewData["Title"] = "Opportunities";
}

<section class="opportunity-header">
        <h1>Opportunities</h1>
        
        <a asp-controller="Opportunity"
           asp-action="Create"
           class="btn app-button">
            Add New Opportunity
        </a>
    </section>
    
<section class="opportunity-content">

    <form asp-action="Opportunities" method="get" class="opportunity-controls">

        <div class ="filter-controls">
        <select name="filter">
            <option value="MostRecent" selected>Most Recent (60 days)</option>
            <option value="ByCenter" >By Center</option>
        </select>
        
        <button type="submit"
                class="filter-button">
            Apply Filter
        </button>
        </div>
                
        <div class="search-controls">
                    <input
                        type="text"
                        name="search"
                        placeholder="Search Opportunities" />

                    <button type="submit"
                            class="search-button">
                        Search
                    </button>
                    </div>
                
            </form>
    <div class="card-container">
            @if (Model != null && Model.Any())
            {
                @foreach (var opportunity in Model)
                {
                    <div class="opportunity-card">
                        <div class="card-header">
                            <h5><strong>Name: </strong>@opportunity.Name</h5>
                        </div>
                    
                        <div class="card-body">
                            <p>Description: @opportunity.Description</p>
                            <p>Center: @opportunity.Center</p>
                            <p>StartDate: @opportunity.StartDate</p>
                            <p>EndDate: @opportunity.EndDate</p>
                            <p>CreatedAt: @opportunity.CreatedAt</p>
                            <p>IsActive: @opportunity.IsActive</p>
                        </div>

                            <div class="card-opportunity-actions">
                                <a asp-action="Matches"
                                   asp-route-id="@opportunity.Id"
                                   class="match-button">
                                    View Matches
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@opportunity.Id"
                                   class="edit-button">
                                    Edit
                                </a>

                                <!-- Card Delete Button -->
                                <button type="button" id="deleteButton-@opportunity.Id" onclick="openDeletePopup(@opportunity.Id)"
                                        class="delete-button">
                                    Delete
                                </button>

                                <!-- Delete Popup -->
                                <div id="deletePopup-@opportunity.Id" class="popup">
                                    <p>Are you sure you want to delete this opportunity?</p>

                                    <button type="button" onclick="closeDeletePopup(@opportunity.Id)"
                                            class="cancel-delete-button">
                                        Cancel
                                    </button>

                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@opportunity.Id"/>

                                        <button type="submit"
                                                class="confirm-delete-button">
                                            Confirm Delete
                                        </button>
                                    </form>
                                </div>

                                <script>
                                    function openDeletePopup(opportunityId) {
                                        document.getElementById("deletePopup-" + opportunityId).classList.add("show");
                                        document.getElementById("deleteButton-" + opportunityId).classList.add("hidden");
                                    }

                                    function closeDeletePopup(opportunityId) {
                                        document.getElementById("deletePopup-" + opportunityId).classList.remove("show");
                                        document.getElementById("deleteButton-" + opportunityId).classList.remove("hidden");
                                    }
                                </script>

                            </div>

                    </div>
                }
            }
            else
            {
                    <div class="no-results">
                        No opportunity found.
                    </div>
            }
            
    </div>
</section>