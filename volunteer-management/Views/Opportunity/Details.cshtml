@model IEnumerable<Match>

@{
    ViewData["Title"] = "Volunteer Opportunity Matches";
}

@{
    var opportunity = Model.FirstOrDefault()?.Opportunity;
}

<section class="opportunity-details-header">
    <h1>Volunteer Opportunity Matches</h1>
    <h2>Matches for @opportunity?.Name</h2> 
</section>

<section class="opportunity-details-content">

    <div class="opportunity-details-list">

        <table class="opportunity-details-table">

            <thead>
            <tr>
                <th>Volunteer</th>
                <th>Email</th>
                <th>Cell-Phone</th>
                <th>Skills/Interests</th>
                <th>Availability</th>
                <th>Educational Background</th>
                <th>Current Licenses</th>
                <th>Status</th>
            </tr>
            </thead>

            <tbody>
            
                @foreach (var match in Model)
                {
                    <tr>
                        <td>
                            @*@match.Volunteer.FirstName @match.Volunteer.LastName*@
                            @match.Volunteer?.FirstName @match.Volunteer?.LastName
                        </td>
                    
                        <td>
                            @*@match.Volunteer.Email*@
                            @match.Volunteer?.Email
                        </td>
                    
                        <td>
                            @*@match.Volunteer.CellPhone*@
                            @match.Volunteer?.CellPhone
                        </td>
                    
                        <td>
                            @*@match.Volunteer.SkillsInterests*@
                            @match.Volunteer?.SkillsInterests
                        </td>
                    
                        <td>
                            @*@match.Volunteer.Availability*@
                            @match.Volunteer?.Availability
                        </td>
                    
                        <td>
                            @*@match.Volunteer.EducationalBackground*@
                            @match.Volunteer?.EducationalBackground
                        </td>
                    
                        <td>
                            @*@match.Volunteer.CurrentLicenses*@
                            @match.Volunteer?.CurrentLicenses
                        </td>
                    
                        <td>
                            @*@match.Volunteer.Status*@
                            @match.Volunteer?.Status 
                        </td>
                    </tr>
                }  
                
            </tbody>

        </table>

    </div>
    
    <a asp-action="Opportunities" class="back-button">
        Back to Opportunities
    </a>

</section>