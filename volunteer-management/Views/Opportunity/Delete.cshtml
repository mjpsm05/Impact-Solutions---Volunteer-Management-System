@model Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<section class="delete-opportunity-header">
    <h1>Delete Opportunity</h1>
</section>

<section class="delete-opportunity-section">

    <p>
        Are you sure you want to delete
        @Model.Name?
    </p>

    <form asp-action="Delete" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="button-group">

            <a asp-action="Opportunities"
               class="back-button">
                Cancel
            </a>

            <button type="submit"
                    class="delete-button">
                Delete
            </button>

        </div>
    </form>
</section>