@*Obj passed from controller*@
@model List<Volunteer> 

<h2>View Volunteers</h2>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>
            Volunteer ID
        </th>
        <th>
            First Name
        </th>
        <th>
            Last Name
        </th>
    </tr>
    </thead>
    
    <tbody>
    @foreach (var obj in Model)
    {
        <tr>
            <td>
                Id
            </td>
            <td>
                FirstName
            </td>
            <td>
                LastName
            </td>
        </tr>
    }
    </tbody>
</table>