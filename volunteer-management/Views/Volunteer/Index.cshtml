@*Obj passed from controller*@
@model List<Volunteer> 

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2>View Volunteers</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Volunteer" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-square"></i>Create New Volunteer
            </a>
        </div>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>
            Volunteer ID
        </th>
        <th>
            First Name
        </th>
        <th>
            Last Name
        </th>
    </tr>
    </thead>
    
    <tbody>
    @foreach (var obj in Model.OrderBy(u=>u.Id))
    {
        <tr>
            <td>
                @obj.Id
            </td>
            <td>
                @obj.FirstName
            </td>
            <td>
                @obj.LastName
            </td>
        </tr>
    }
    </tbody>
</table>