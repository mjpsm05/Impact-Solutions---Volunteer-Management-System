@model List<Volunteer> 

@{
    ViewData["Title"] = "Volunteer Profiles";
}

<section class="volunteer-header">
        <h1>Volunteer Profiles</h1>
        
        <a asp-controller="Volunteer"
           asp-action="Add"
           class="btn app-button">
            Add New Volunteer
        </a>
    </section>
    
<section class="volunteer-content">

    <form asp-action="Index" method="get" class="volunteer-controls">

        <div class ="filter-controls">
        <select name="filter">
            <option value="ApprovedPending">Approved/Pending Approval</option>
            <option value="Approved">Approved</option>
            <option value="Pending">Pending Approval </option>
            <option value="Disapproved">Disapproved</option>
            <option value="Inactive">Inactive</option>
            <option value="All" selected>All</option>
        </select>
        
        <button type="submit"
                class="filter-button">
            Apply Filter
        </button>
        </div>
                
        <div class="search-controls">
                    <input
                        type="text"
                        name="search"
                        placeholder="Search Volunteers" />

                    <button type="submit"
                            class="search-button">
                        Search
                    </button>
                    </div>
                
            </form>
       
    <div class="card-container">
        @if (Model != null && Model.Any())
        {
            @foreach (var volunteer in Model)
            {
                <div class="volunteer-card">
                    <div class="card-header">
                        <h5><strong>Name: </strong>@volunteer.FirstName @volunteer.LastName</h5>
                    </div>

                    <div class="card-body">
                        <p>Status: @volunteer.Status</p>
                        <p>Preferred Centers: @volunteer.PreferredCenters</p>
                        <p>Skills/Interests: @volunteer.SkillsInterests</p>
                        <p>Availability: @volunteer.Availability</p>
                        <p>Cell-Phone: @volunteer.CellPhone</p>
                        <p>Email: @volunteer.Email</p>
                    </div>

                    <div class="card-volunteer-actions">
                        <a asp-action="Matches"
                           asp-route-id="@volunteer.Id">
                            View Matches
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@volunteer.Id">
                            Edit
                        </a>

                        <!-- Details button -->
                        <button type="button"
                                id="detailsButton-@volunteer.Id"
                                onclick="openDetailsPopup(@volunteer.Id)"
                                class="details-button">
                            Details
                        </button>

                        <!-- Details popup for this volunteer -->
                        <div id="detailsPopup-@volunteer.Id" class="popup details-popup">
                            <h3>Volunteer Details</h3>

                            <p>
                                <strong>First Name:</strong>
                                @volunteer.FirstName
                            </p>

                            <p>
                                <strong>Last Name:</strong>
                                @volunteer.LastName
                            </p>


                            <p>
                                <strong>Preferred Centers:</strong>
                                @volunteer.PreferredCenters
                            </p>

                            <p>
                                <strong>Skills/Interests:</strong>
                                @volunteer.SkillsInterests
                            </p>

                            <p>
                                <strong>Availability:</strong>
                                @volunteer.Availability
                            </p>

                            <p>
                                <strong>Address:</strong>
                                @volunteer.AddressLine1, @volunteer.City, @volunteer.State @volunteer.PostalCode
                            </p>

                            <p>
                                <strong>Home-Phone:</strong>
                                @volunteer.HomePhone
                            </p>

                            <p>
                                <strong>Work-Phone:</strong>
                                @volunteer.WorkPhone
                            </p>

                            <p>
                                <strong>Cell-Phone:</strong>
                                @volunteer.CellPhone
                            </p>

                            <p>
                                <strong>Email:</strong>
                                @volunteer.Email
                            </p>

                            <p>
                                <strong>Educational Background:</strong>
                                @volunteer.EducationalBackground
                            </p>

                            <p>
                                <strong>Current Licenses:</strong>
                                @volunteer.CurrentLicenses
                            </p>

                            <p>
                                <strong>Emergency Contact Name:</strong>
                                @volunteer.EmergencyContactName
                            </p>

                            <p>
                                <strong>Emergency Contact Home-Phone:</strong>
                                @volunteer.EmergencyContactHomePhone
                            </p>

                            <p>
                                <strong>Emergency Contact Work-Phone:</strong>
                                @volunteer.EmergencyContactWorkPhone
                            </p>

                            <p>
                                <strong>Emergency Contact Email:</strong>
                                @volunteer.EmergencyContactEmail
                            </p>

                            <p>
                                <strong>Emergency Contact Address:</strong>
                                @volunteer.EmergencyContactAddress
                            </p>

                            <p>
                                <strong>Copy of Volunteer's Drivers License on File:</strong>
                                @volunteer.HasDriversLicenseCopy
                            </p>

                            <p>
                                <strong>Copy of Volunteer's Social Security Card on File:</strong>
                                @volunteer.HasSocialSecurityCardCopy
                            </p>

                            <p>
                                <strong>Volunteer's Approval Status:</strong>
                                @volunteer.Status
                            </p>

                            <button type="button"
                                    onclick="closeDetailsPopup(@volunteer.Id)"
                                    class="close-button">
                                Close
                            </button>
                        </div>

                        <script>
                            function openDetailsPopup(volunteerId) {
                                document.getElementById("detailsPopup-" + volunteerId).classList.add("show");
                                document.getElementById("detailsButton-" + volunteerId).classList.add("hidden");
                            }

                            function closeDetailsPopup(volunteerId) {
                                document.getElementById("detailsPopup-" + volunteerId).classList.remove("show");
                                document.getElementById("detailsButton-" + volunteerId).classList.remove("hidden");
                            }
                        </script>

                    </div>
                </div>
            }
        }
                        else
                        {
                            <div class ="no-results" >
                                No volunteers found.
                                </div>
                        }
    </div>
 </section>


