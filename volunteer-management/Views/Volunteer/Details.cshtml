<!-- Need a matches view model -->
 @* @model VolunteerMatchesViewModel *@


@{
    ViewData["Title"] = "Volunteer Opportunity Matches";
}

<section class="volunteer-details-header">
    <h1>Volunteer Opportunity Matches</h1>
    <!-- Need a volunteer property in view model -->
    <p>Matches for @Model.Volunteer.FirstName @Model.Volunteer.LastName</p> 
</section>

<section class="volunteer-details-content">

    <div class="volunteer-details-list">

        <table class="volunteer-details-table">

            <thead>
            <tr>
                <th>Opportunity</th>
                <th>Description</th>
                <th>Center</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Currently Active?</th>
            </tr>
            </thead>

            <tbody>

            
            @foreach (var opportunity in Model)
            {
                <tr>
                    <td>
                        @opportunity.Name
                    </td>
                    
                    <td>
                        @opportunity.Description
                    </td>
                    
                    <td>
                        @opportunity.Center
                    </td>
                    
                    <td>
                        @opportunity.StartDate
                    </td>
                    
                    <td>
                        @opportunity.EndDate
                    </td>
                    
                    <td>
                        @opportunity.IsActive
                    </td>
                    
                </tr>
            }

            </tbody>

        </table>

    </div>
    
    <a asp-action="Index" class="back-button">
        Back to Volunteers
    </a>

</section>



