@model IEnumerable<Match>

@{
    ViewData["Title"] = "Volunteer Opportunity Matches";
}

@{
    var volunteer = Model.FirstOrDefault()?.Volunteer;
}

<section class="volunteer-details-header">
    <h1>Volunteer Opportunity Matches</h1>
    <h2>Matches for @volunteer?.FirstName @volunteer?.LastName</h2> 
</section>

<section class="volunteer-details-content">

    <div class="volunteer-details-list">

        <table class="volunteer-details-table">

            <thead>
            <tr>
                <th>Opportunity</th>
                <th>Description</th>
                <th>Center</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Created</th>
                <th>Active</th>
            </tr>
            </thead>

            <tbody>
            
            
                @foreach (var match in Model)
                {
                    <tr>
                        <td>
                            @*@match.Opportunity.Name*@
                            @match.Opportunity?.Name
                        </td>
                    
                        <td>
                            @*@match.Opportunity.Description*@
                            @match.Opportunity?.Description
                        </td>
                    
                        <td>
                            @*@match.Opportunity.Center*@
                            @match.Opportunity?.Center
                        </td>
                    
                        <td>
                            @*@match.Opportunity.StartDate*@
                            @match.Opportunity?.StartDate
                        </td>
                    
                        <td>
                            @*@match.Opportunity.EndDDate*@
                            @match.Opportunity?.EndDate
                        </td>
                    
                        <td>
                            @*@match.Opportunity.CreatedAt*@
                            @match.Opportunity?.CreatedAt
                        </td>
                    
                        <td>
                            @*@match.Opportunity.IsActive*@
                            @match.Opportunity?.IsActive
                        </td>
                    
                    </tr>
                } 
            }
            

            </tbody>

        </table>

    </div>
    
    <a asp-action="Index" class="back-button">
        Back to Volunteers
    </a>

</section>



