@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-header">
    <h1>Welcome, Administrator</h1>

    <p>
        Choose an area below to manage volunteer information
        or volunteer opportunities.
    </p>
</section>

<section class="dashboard-grid"
         aria-label="Management options">

    <article class="dashboard-card">
        <div class="dashboard-card-content">
            <h2>Volunteer Profiles</h2>

            <p>
                View, create, edit, and manage volunteer profile information.
            </p>
        </div>

        <a asp-controller="Volunteer"
           asp-action="Index"
           class="btn app-button">
            Manage Volunteers
        </a>
    </article>

    <article class="dashboard-card">
        <div class="dashboard-card-content">
            <h2>Volunteer Opportunities</h2>

            <p>
                View, create, edit, and manage available volunteer opportunities.
            </p>
        </div>

        <a asp-controller="Opportunity"
           asp-action="Opportunities"
           class="btn app-button">
            Manage Opportunities
        </a>
    </article>

</section>